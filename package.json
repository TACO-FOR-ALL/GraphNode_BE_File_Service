    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "sqs-consumer": "^14.2.0",
    "ulid": "^3.0.1",
    "uuid": "^11.0.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.9.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
