  "description": "GraphNode File Service — AI export ZIP import, S3, presigned access",
  "main": "dist/index-api.js",
  "scripts": {
    "dev": "tsx watch src/index-api.ts",
    "dev:worker": "tsx watch src/index-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index-api.js",
    "start:worker": "node dist/index-worker.js",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "license": "ISC",
