# Development example env — copy to .env and fill in values
# cp .env.example .env
#
# 운영(prod): ECS Task Definition + Secrets Manager (docs/INFRA_AWS.md)
# BFF 연동: GraphNode BE FILE_SERVICE_INTERNAL_API_KEY = 아래 INTERNAL_API_KEY 와 동일

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL — import job / file 메타 (Prisma schema.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/graphnode_file_service

# BFF ↔ File Service internal API 공유 키 (GraphNode BE FILE_SERVICE_INTERNAL_API_KEY 와 동일)
INTERNAL_API_KEY=change-me-local-dev-key

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack / MinIO 등 로컬 S3·SQS 사용 시만 설정 (빈 값이면 SDK 기본 체인)
# AWS_ENDPOINT_URL=http://localhost:4566

# S3 — GraphNode BE S3_FILE_BUCKET 과 동일 버킷 권장
S3_FILE_BUCKET=taco5-graphnode-filedata-chat-and-note-s3

# Import worker 큐 (로컬 미설정 시 startImport enqueue 스킵 가능, production 필수)
SQS_IMPORT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/graphnode-file-import-jobs-dev

# ZIP / import 제한
MAX_ZIP_BYTES=5368709120
MAX_ZIP_DEPTH=3
MAX_NESTED_ZIPS=50
MAX_ZIP_ENTRIES=100000
MAX_UNCOMPRESSED_BYTES=16106127360
MAX_ACTIVE_JOBS_PER_USER=2
MAX_IMPORTS_PER_USER_PER_DAY=10

# Presigned URL TTL (초)
PRESIGN_TTL_SEC=300
PRESIGN_UPLOAD_TTL_SEC=900

# Worker (API 컨테이너: false, worker 컨테이너: true)
IMPORT_WORKER_ENABLED=true
IMPORT_WORKER_CONCURRENCY=2
