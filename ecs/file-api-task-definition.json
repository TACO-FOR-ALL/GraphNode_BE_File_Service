{
  "family": "graphnode-file-service-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::571721033550:role/graphnode-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::571721033550:role/graphnode-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "graphnode_file_service_api",
      "image": "571721033550.dkr.ecr.ap-northeast-2.amazonaws.com/taco5/graphnode-file-service:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "3001" },
        { "name": "AWS_REGION", "value": "ap-northeast-2" },
        { "name": "S3_FILE_BUCKET", "value": "taco5-graphnode-filedata-chat-and-note-s3" },
        { "name": "PRESIGN_TTL_SEC", "value": "300" },
        { "name": "PRESIGN_UPLOAD_TTL_SEC", "value": "900" },
        { "name": "IMPORT_WORKER_ENABLED", "value": "false" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:571721033550:secret:taco5/graphnode/file-service-vnN9VL:DATABASE_URL::"
        },
        {
          "name": "INTERNAL_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:571721033550:secret:taco5/graphnode/file-service-vnN9VL:INTERNAL_API_KEY::"
        },
        {
          "name": "SQS_IMPORT_QUEUE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:571721033550:secret:taco5/graphnode/file-service-vnN9VL:SQS_IMPORT_QUEUE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/graphnode-file-service-api",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
